{
  "name": "news-aggregator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:web": "vite",
    "dev:server": "PORT=8787 tsx watch --tsconfig tsconfig.server.json --env-file-if-exists=.env server/index.ts",
    "build": "tsc -b && vite build && pnpm build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --tsconfig=tsconfig.server.json --outfile=dist-server/index.js --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\"",
    "start": "STATIC_DIR=./dist node --env-file-if-exists=.env dist-server/index.js",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "prepare": "husky",
    "secrets": "secretlint --secretlintignore .secretlintignore \"**/*\""
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/node-server": "^2.1.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "entities": "^8.1.0",
    "hono": "^4.13.13",
    "lucide-react": "^1.53.0",
    "motion": "^14.0.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@secretlint/secretlint-rule-pattern": "^13.0.7",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.81.0",
    "secretlint": "^13.0.7",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@9.14.4",
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "oxlint --deny-warnings"
    ],
    "*": [
      "secretlint --secretlintignore .secretlintignore"
    ]
  }
}
