# Copy to .env. Only the server reads these, they never go to the browser.
# Leave them empty to run with sample articles.
GUARDIAN_API_KEY=
NYT_API_KEY=
NEWSAPI_API_KEY=

# Optional
# PORT=8787                  # the Docker image uses 8080
# RATE_LIMIT_PER_MINUTE=60   # per client IP
# CACHE_TTL_SECONDS=300
# TRUST_PROXY=false          # true only behind a reverse proxy you run
