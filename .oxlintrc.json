{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import"],
  "ignorePatterns": ["dist", "dist-server", "api/_server.js", "node_modules", "coverage"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],

    "func-style": ["error", "expression"],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-imports": "error",
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "no-console": "error",
    "import/no-duplicates": "error"
  },
  "overrides": [
    {
      "files": ["server/**"],
      "rules": { "no-console": "off" }
    },
    {
      // generated by the shadcn CLI, kept close to upstream
      "files": ["src/components/ui/**"],
      "rules": { "react/only-export-components": "off", "react-hooks/exhaustive-deps": "off" }
    }
  ]
}
