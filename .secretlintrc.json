{
  "rules": [
    { "id": "@secretlint/secretlint-rule-preset-recommend" },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "News API key assignment",
            "pattern": "/(GUARDIAN|NYT|NEWSAPI)_API_KEY\\s*[=:]\\s*[\"']?[A-Za-z0-9-]{16,}/"
          }
        ]
      }
    }
  ]
}
